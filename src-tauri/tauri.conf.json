{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOP-to-Skill",
  "version": "0.2.0",
  "identifier": "com.skillsfornoengineer.configurator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": true
    },
    "windows": [
      {
        "label": "main",
        "title": "SOP to Skill",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "resources": [
      "../skills"
    ],
    "shortDescription": "Turn SOPs into installable skills.",
    "longDescription": "A desktop app that guides non-technical users through turning SOPs into reusable, installable skills.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
